# Copy to .env and fill in your values. Never commit the real .env file.
# Both okta-token-helper.sh and okta-token-helper.py read these same vars.

# Okta org base URL, including scheme (e.g. https://your-org.okta.com)
OKTA_DOMAIN=https://your-org.okta.com

# Client ID of the Okta OIDC native/CLI app used for the PKCE login
OKTA_CLIENT_ID=0oa1b2c3d4YourClientId

# Local port the helper script listens on for the PKCE redirect callback
OKTA_REDIRECT_PORT=8080

# API audience the gateway expects in the issued access token
OKTA_AUDIENCE=api://default

# Okta authorization server ID ("default" unless a custom one is configured)
OKTA_AUTH_SERVER=default

# Optional: path to a PEM CA bundle for environments behind a TLS-inspecting
# (MITM) proxy whose root CA isn't in Python's/curl's own trust store, even
# though your OS/browser already trusts it. Leave unset for normal use.
OKTA_CA_BUNDLE=
